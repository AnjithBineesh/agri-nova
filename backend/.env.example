# ---- Core -------------------------------------------------------------------
ENVIRONMENT=development
# SQLite for local development. For production use PostgreSQL + PostGIS:
# DATABASE_URL=postgresql+psycopg://agrinova:agrinova@localhost:5432/agrinova
# USE_POSTGIS=true
DATABASE_URL=sqlite:///./agrinova.db
USE_POSTGIS=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- File storage -------------------------------------------------------------
STORAGE_BACKEND=local          # local | s3
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
MAX_UPLOAD_MB=15
TESSERACT_CMD=tesseract

# ---- NASA POWER (no credentials needed) -------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_POWER_COMMUNITY=AG

# ---- NASA Earthdata Login (GPM IMERG via Giovanni; SMAP, MODIS, HLS, ECOSTRESS, SRTM via AppEEARS)
# Register at https://urs.earthdata.nasa.gov/ . Either set username+password (needed for AppEEARS)
# or a bearer token (Giovanni). Never put these in the frontend.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Product identifiers – check current versions with GET https://appeears.earthdatacloud.nasa.gov/api/product
SMAP_L3_PRODUCT=SPL3SMP_E.006
SMAP_L4_PRODUCT=SPL4SMGP.008
MODIS_VI_PRODUCT=MOD13Q1.061
HLS_LANDSAT_PRODUCT=HLSL30.020
HLS_SENTINEL_PRODUCT=HLSS30.020
ECOSTRESS_LST_PRODUCT=ECO_L2T_LSTE.002
ECOSTRESS_ET_PRODUCT=ECO_L3T_JET.002
SRTM_PRODUCT=SRTMGL1_NC.003
GPM_IMERG_FINAL_VARIABLE=GPM_3IMERGDF_07_precipitation
GPM_IMERG_LATE_VARIABLE=GPM_3IMERGDL_07_precipitation

# ---- Copernicus CDS (ERA5 – adapter interface only in this release) ---------
CDS_API_KEY=

# ---- HTTP behaviour -----------------------------------------------------------
HTTP_TIMEOUT_SECONDS=45
HTTP_MAX_RETRIES=3
CACHE_TTL_HOURS=168

# ---- Demonstration data -------------------------------------------------------
# false by default. When true, users can explicitly load a synthetic, clearly labelled dataset
# for offline demos. It is never used automatically and never shown as NASA data.
ENABLE_DEMO_DATA=false
